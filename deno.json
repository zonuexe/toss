{
  "name": "@tosslang/toss",
  "version": "0.0.1",
  "exports": {
    ".": "./src/compiler.ts",
    "./source": "./src/source_compiler.ts",
    "./repl": "./src/repl_core.ts",
    "./cli": "./src/cli.ts",
    "./repl-cli": "./src/repl_cli.ts",
    "./runtime-cli": "./src/runtime_cli.ts"
  },
  "publish": {
    "include": [
      "deno.json",
      "src/",
      "lib/",
      "LICENSE",
      "README.md",
      "README-ja.md",
      "docs/",
      "CHANGELOG.md"
    ]
  },
  "tasks": {
    "compile": "deno run --allow-read --allow-write src/cli.ts",
    "runtime": "deno run --allow-write src/runtime_cli.ts",
    "repl": "deno run --allow-read --allow-write src/repl_cli.ts",
    "test": "deno test --allow-read --allow-write --allow-run=deno tests/",
    "check": "deno fmt --check && deno lint && deno check src/cli.ts src/runtime_cli.ts src/repl_cli.ts tests/*.ts"
  },
  "imports": {
    "acorn": "npm:acorn@8.15.0",
    "hono": "npm:hono@4.12.12"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "fmt": {
    "include": ["src/", "tests/", "deno.json"]
  },
  "lint": {
    "include": ["src/", "tests/"]
  },
  "exclude": ["out/"]
}
