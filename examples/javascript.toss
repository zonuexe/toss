// Evaluate a host expression and pass Toss values explicitly.
#n bind: 3.
%js(x = $n; Math.max(x, 7)) print.

// Statements can run inside a function expression.
%js((() => { const x = 3; return x * 2; })()) print.

// Native method calls keep their JavaScript receiver.
#counter bind: %js(({ count: 10, add(n) { this.count += n; return this.count; } })).
%js(counter = $counter; counter.add(2)) print.
$counter dump.

// Mutations of a passed Toss Array remain visible in Toss.
#items bind: [1, 2, 3].
%js(xs = $items; xs.push(4)).
$items dump.

// Function results are JS references; call them through another JS expression.
#double bind: %js(x => x * 2).
%js(f = $double, x = $n; f(x)) print.
