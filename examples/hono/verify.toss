#app bind: %import('./app.toss').

%js(app = $app; (async () => {
  const check = (condition, message) => {
    if (!condition) throw new Error(message);
  };
  const hello = await app.request('/hello/Toss');
  const helloBody = await hello.text();
  check(hello.status === 200 && helloBody === 'Hello, Toss!', 'GET greeting failed');
  check(hello.headers.get('X-Toss') === 'after', 'GET greeting after header missing');
  check(hello.headers.get('X-Toss-Trace') === 'before,handler,after', 'GET greeting trace failed');
  console.log('GET /hello/Toss: ' + hello.status + ' ' + helloBody);

  const echo = async name => {
    const response = await app.request('/echo', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name }),
    });
    const body = await response.json();
    check(response.status === 201, 'POST /echo status failed for ' + name);
    check(body.name === name && body.language === 'Toss', 'POST /echo body failed for ' + name);
    check(response.headers.get('X-Toss') === 'after', 'POST /echo after header missing for ' + name);
    check(response.headers.get('X-Toss-Trace') === 'before,handler,after', 'POST /echo trace failed for ' + name);
    return { response, body };
  };
  const [alice, bob] = await Promise.all([echo('Alice'), echo('Bob')]);
  console.log('POST /echo Alice: ' + alice.response.status + ' ' + JSON.stringify(alice.body));
  console.log('POST /echo Bob: ' + bob.response.status + ' ' + JSON.stringify(bob.body));

  const invalidJson = await app.request('/echo', {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{',
  });
  const invalidJsonBody = await invalidJson.json();
  check(invalidJson.status === 400 && invalidJsonBody.error === 'invalid body', 'invalid JSON response failed');
  check(invalidJson.headers.get('X-Toss') === 'after', 'middleware did not resume after invalid JSON');
  check(invalidJson.headers.get('X-Toss-Trace') === 'before,after', 'invalid JSON trace failed');
  console.log('POST /echo invalid JSON: ' + invalidJson.status + ' ' + JSON.stringify(invalidJsonBody));

  const invalidName = await app.request('/echo', {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: 42 }),
  });
  const invalidNameBody = await invalidName.json();
  check(invalidName.status === 400 && invalidNameBody.error === 'name must be a String', 'invalid name response failed');
  check(invalidName.headers.get('X-Toss-Trace') === 'before,handler,after', 'invalid name trace failed');
  console.log('POST /echo invalid name: ' + invalidName.status + ' ' + JSON.stringify(invalidNameBody));

  const missing = await app.request('/missing');
  check(missing.status === 404, 'missing route status failed');
  check(missing.headers.get('X-Toss') === 'after', 'missing route middleware header failed');
  check(missing.headers.get('X-Toss-Trace') === 'before,after', 'missing route trace failed');
  console.log('GET /missing: ' + missing.status + '');
  console.log('Hono verification passed (6 checks)');
})()).
