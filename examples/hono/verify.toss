%macroImport('../../lib/hono/macros.toss').
#app bind: %import('./app.toss').
#adapter bind: %import('../../lib/hono/adapter.toss').
#testing bind: %import('../../lib/hono/testing.toss').

#verifyEcho bind: %async({ response,name ->
  #body bind: %await($testing bodyJSON: $response).
  $testing actual: ($testing status: $response) equals: 201 because: 'POST /echo status failed'.
  $testing actual: ($testing field: 'name' of: $body) equals: $name because: 'POST /echo body name failed'.
  $testing actual: ($testing field: 'language' of: $body) equals: 'Toss' because: 'POST /echo body language failed'.
  $testing actual: ($testing header: 'X-Toss' of: $response) equals: 'after' because: 'POST /echo after header missing'.
  $testing actual: ($testing header: 'X-Toss-Trace' of: $response) equals: 'before,handler,after' because: 'POST /echo trace failed'.
  $testing report: ($adapter join: 'POST /echo ' with: $name) response: $response body: $body
}).

#execution bind: %runAsync({
  #hello bind: %request($app request: '/hello/Toss').
  #helloBody bind: %await($testing bodyText: $hello).
  $testing actual: ($testing status: $hello) equals: 200 because: 'GET greeting status failed'.
  $testing actual: $helloBody equals: 'Hello, Toss!' because: 'GET greeting body failed'.
  $testing actual: ($testing header: 'X-Toss' of: $hello) equals: 'after' because: 'GET greeting after header missing'.
  $testing actual: ($testing header: 'X-Toss-Trace' of: $hello) equals: 'before,handler,after' because: 'GET greeting trace failed'.
  $testing report: 'GET /hello/Toss' response: $hello body: $helloBody.

  #aliceCall bind: %async({ %await($app request: '/echo' options: ($testing jsonOptions: ($Object clone |> %extend(name: 'Alice')))) }).
  #bobCall bind: %async({ %await($app request: '/echo' options: ($testing jsonOptions: ($Object clone |> %extend(name: 'Bob')))) }).
  #echoes bind: %await($testing concurrent: ($aliceCall value) with: ($bobCall value)).
  %await($verifyEcho value: ($testing at: 0 in: $echoes) value: 'Alice').
  %await($verifyEcho value: ($testing at: 1 in: $echoes) value: 'Bob').

  #invalidJson bind: %request($app request: '/echo' options: ($testing rawJSONOptions: '{')).
  #invalidJsonBody bind: %await($testing bodyJSON: $invalidJson).
  $testing actual: ($testing status: $invalidJson) equals: 400 because: 'invalid JSON response status failed'.
  $testing actual: ($testing field: 'error' of: $invalidJsonBody) equals: 'invalid body' because: 'invalid JSON response body failed'.
  $testing actual: ($testing header: 'X-Toss' of: $invalidJson) equals: 'after' because: 'middleware did not resume after invalid JSON'.
  $testing actual: ($testing header: 'X-Toss-Trace' of: $invalidJson) equals: 'before,after' because: 'invalid JSON trace failed'.
  $testing report: 'POST /echo invalid JSON' response: $invalidJson body: $invalidJsonBody.

  #invalidName bind: %request($app request: '/echo' options: ($testing jsonOptions: ($Object clone |> %extend(name: 42)))).
  #invalidNameBody bind: %await($testing bodyJSON: $invalidName).
  $testing actual: ($testing status: $invalidName) equals: 400 because: 'invalid name response status failed'.
  $testing actual: ($testing field: 'error' of: $invalidNameBody) equals: 'name must be a String' because: 'invalid name response body failed'.
  $testing actual: ($testing header: 'X-Toss-Trace' of: $invalidName) equals: 'before,handler,after' because: 'invalid name trace failed'.
  $testing report: 'POST /echo invalid name' response: $invalidName body: $invalidNameBody.

  #missing bind: %request($app request: '/missing').
  $testing actual: ($testing status: $missing) equals: 404 because: 'missing route status failed'.
  $testing actual: ($testing header: 'X-Toss' of: $missing) equals: 'after' because: 'missing route middleware header failed'.
  $testing actual: ($testing header: 'X-Toss-Trace' of: $missing) equals: 'before,after' because: 'missing route trace failed'.
  $testing report: 'GET /missing' response: $missing body: $Nil.
  'Hono verification passed (6 checks)' print.
}).
