#numbers bind: [1, 2, 3, 4, 5, 6].
#even bind: ($numbers filter: { number ->
  ($number remainder: 2) equals: 0
}).
#large bind: ($numbers filter: { number ->
  $number greaterThan: 3
}).

($even length) print.
($even at: 0) print.
($even at: 1) print.
($even at: 2) print.
($large length) print.
($large at: 0) print.
($large at: 1) print.
($large at: 2) print.
